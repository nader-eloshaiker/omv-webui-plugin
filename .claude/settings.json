{
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.agents/hooks/grep-lsp-reminder.mjs\"; [ -f \"$f\" ] && node \"$f\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
