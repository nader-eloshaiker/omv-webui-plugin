# Vite mode file for `pnpm dev:mock` (vite --mode mock).
#
# The app runs entirely in the browser on MSW, which answers rpc.php with the contract's examples
# (@omv-webui/react-api-omv/mocks). The mock holds no data; a scenario picker in the corner chooses
# which examples answer (src/mocks/scenarios.ts). Nothing from this mode reaches a production build
# (UI-11): the mock is loaded behind `import.meta.env.DEV`, which a build replaces with false.
VITE_MOCK_API=true
