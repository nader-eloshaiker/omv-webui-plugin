{
  "name": "omv-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "The interface: Vite at base /ui/, TanStack Router and Query, i18n, sign-in and the shell.",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "build:lab": "tsc -b && vite build --mode lab --outDir dist-lab",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "playwright test --config e2e/playwright.config.ts",
    "test:browser:install": "playwright install chromium",
    "test:browser:lab": "playwright test --config e2e/lab/playwright.config.ts",
    "test:browser:stories": "playwright test --config e2e/stories/playwright.config.ts",
    "test:browser:vm": "playwright test --config e2e/vm/playwright.config.ts"
  },
  "dependencies": {
    "@omv-webui/css-ui-style": "workspace:*",
    "@omv-webui/react-api-omv": "workspace:*",
    "@omv-webui/react-ui-components": "workspace:*",
    "@tanstack/react-query": "catalog:tanstack",
    "@tanstack/react-router": "catalog:tanstack",
    "i18next": "catalog:i18n",
    "lucide-react": "catalog:ui",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-i18next": "catalog:i18n",
    "react-is": "catalog:charts",
    "recharts": "catalog:charts",
    "zustand": "catalog:react"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:testing",
    "@playwright/test": "catalog:testing",
    "@tailwindcss/vite": "catalog:style",
    "@tanstack/router-plugin": "catalog:tanstack",
    "@testing-library/jest-dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@testing-library/user-event": "catalog:testing",
    "@types/node": "catalog:build",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-react": "catalog:build",
    "happy-dom": "catalog:testing",
    "msw": "catalog:api",
    "tailwindcss": "catalog:style",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:testing"
  }
}
