{
  "openapi": "3.0.3",
  "info": {
    "title": "openmediavault-webui contract",
    "version": "0.0.0",
    "description": "The backend methods the openmediavault web interface calls, described from OMV's source and from replies captured on a test system. Nothing on the server reads this document.",
    "license": {
      "name": "GPL-3.0-or-later",
      "url": "https://www.gnu.org/licenses/gpl-3.0.html"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Session"
    },
    {
      "name": "System"
    },
    {
      "name": "Config"
    },
    {
      "name": "Exec"
    },
    {
      "name": "SSH"
    },
    {
      "name": "ShareMgmt"
    },
    {
      "name": "UserMgmt"
    }
  ],
  "paths": {
    "/rpc/Session/login": {
      "post": {
        "operationId": "sessionLogin",
        "tags": ["Session"],
        "summary": "Sign in",
        "description": "Sign in with a user name and password. Wrong credentials are HTTP 400; too many failed second-factor attempts for the user are HTTP 429. Never retried automatically (UI-14).",
        "x-omv-rpc": {
          "service": "Session",
          "method": "login"
        },
        "x-omv-role": "public",
        "x-omv-readonly": false,
        "x-omv-source": {
          "datamodel": "rpc.session.login",
          "omvVersion": "8.6.1"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The method's response value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionLoginReply"
                },
                "examples": {
                  "authenticated": {
                    "$ref": "#/components/examples/sessionLogin.authenticated"
                  },
                  "challengeRequired": {
                    "$ref": "#/components/examples/sessionLogin.challengeRequired"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Wrong user name or password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcErrorDetail"
                },
                "examples": {
                  "wrongPassword": {
                    "$ref": "#/components/examples/sessionLogin.wrongPassword"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rpc/Session/verify": {
      "post": {
        "operationId": "sessionVerify",
        "tags": ["Session"],
        "summary": "Complete a second-factor sign-in",
        "description": "Answer the pending challenge of Session.login. HTTP 400 for a wrong code; 429 from the third failure on, with a growing delay; 401 when no login is pending or it expired (A10).",
        "x-omv-rpc": {
          "service": "Session",
          "method": "verify"
        },
        "x-omv-role": "public",
        "x-omv-readonly": false,
        "x-omv-source": {
          "datamodel": "rpc.session.verify",
          "omvVersion": "8.6.1"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The method's response value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionAuthenticated"
                },
                "examples": {
                  "authenticated": {
                    "$ref": "#/components/examples/sessionVerify.authenticated"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Wrong code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RpcErrorDetail"
                },
                "examples": {
                  "wrongCode": {
                    "$ref": "#/components/examples/sessionVerify.wrongCode"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rpc/Session/logout": {
      "post": {
        "operationId": "sessionLogout",
        "tags": ["Session"],
        "summary": "Sign out",
        "description": "End the session. Returns null.",
        "x-omv-rpc": {
          "service": "Session",
          "method": "logout"
        },
        "x-omv-role": "user",
        "x-omv-readonly": false,
        "responses": {
          "200": {
            "description": "The method returns null."
          }
        }
      }
    },
    "/rpc/System/getInformation": {
      "post": {
        "operationId": "systemGetInformation",
        "tags": ["System"],
        "summary": "System information",
        "description": "Host, version, load and memory, and whether configuration changes are pending. A user gets only the time and host name.",
        "x-omv-rpc": {
          "service": "System",
          "method": "getInformation"
        },
        "x-omv-role": "user",
        "x-omv-readonly": true,
        "responses": {
          "200": {
            "description": "The method's response value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInformation"
                },
                "examples": {
                  "admin": {
                    "$ref": "#/components/examples/systemGetInformation.admin"
                  },
                  "adminPendingChanges": {
                    "$ref": "#/components/examples/systemGetInformation.adminPendingChanges"
                  },
                  "user": {
                    "$ref": "#/components/examples/systemGetInformation.user"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rpc/Config/isDirty": {
      "post": {
        "operationId": "configIsDirty",
        "tags": ["Config"],
        "summary": "Are configuration changes pending?",
        "description": "True when saved settings have not been applied yet.",
        "x-omv-rpc": {
          "service": "Config",
          "method": "isDirty"
        },
        "x-omv-role": "admin",
        "x-omv-readonly": true,
        "x-omv-source": {
          "datamodel": "rpc.config.isDirty",
          "omvVersion": "8.6.1"
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigIsDirtyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The method's response value.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                },
                "examples": {
                  "clean": {
                    "$ref": "#/components/examples/configIsDirty.clean"
                  },
                  "dirty": {
                    "$ref": "#/components/examples/configIsDirty.dirty"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rpc/Config/applyChangesBg": {
      "post": {
        "operationId": "configApplyChangesBg",
        "tags": ["Config"],
        "summary": "Apply pending changes",
        "description": "Deploy the pending configuration changes, as a background task. Services may restart. The task's result is the list of modules deployed.",
        "x-omv-rpc": {
          "service": "Config",
          "method": "applyChangesBg"
        },
        "x-omv-role": "admin",
        "x-omv-readonly": false,
        "x-omv-task": {
          "result": "ConfigAppliedModules"
        },
        "x-omv-destructive": "service",
        "x-omv-source": {
          "datamodel": "rpc.config.applychanges",
          "omvVersion": "8.6.1"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigApplyChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The method's response value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskHandle"
                },
                "examples": {
                  "applied": {
                    "$ref": "#/components/examples/configApplyChangesBg.applied"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rpc/Config/revertChangesBg": {
      "post": {
        "operationId": "configRevertChangesBg",
        "tags": ["Config"],
        "summary": "Discard pending changes",
        "description": "Throw away every saved change that has not been applied, as a background task. Nothing is deployed.",
        "x-omv-rpc": {
          "service": "Config",
          "method": "revertChangesBg"
        },
        "x-omv-role": "admin",
        "x-omv-readonly": false,
        "x-omv-task": {},
        "x-omv-source": {
          "datamodel": "rpc.config.revertchanges",
          "omvVersion": "8.6.1"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigRevertChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The method's response value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskHandle"
                },
                "examples": {
                  "reverted": {
                    "$ref": "#/components/examples/configRevertChangesBg.reverted"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rpc/Exec/getOutput": {
      "post": {
        "operationId": "execGetOutput",
        "tags": ["Exec"],
        "summary": "Read a task's output",
        "description": "Used only by the task helper. Not read-only: the last poll of a finished task deletes it on the server (A6).",
        "x-omv-rpc": {
          "service": "Exec",
          "method": "getOutput"
        },
        "x-omv-role": "admin",
        "x-omv-readonly": false,
        "x-omv-source": {
          "datamodel": "rpc.exec.getoutput",
          "omvVersion": "8.6.1"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecGetOutputRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The method's response value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecOutput"
                },
                "examples": {
                  "appliedFinished": {
                    "$ref": "#/components/examples/execGetOutput.appliedFinished"
                  },
                  "revertedFinished": {
                    "$ref": "#/components/examples/execGetOutput.revertedFinished"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rpc/Exec/isRunning": {
      "post": {
        "operationId": "execIsRunning",
        "tags": ["Exec"],
        "summary": "Is a task still running?",
        "description": "Used only by the task helper, and not for polling: on a finished task it deletes the task, so a later getOutput fails.",
        "x-omv-rpc": {
          "service": "Exec",
          "method": "isRunning"
        },
        "x-omv-role": "admin",
        "x-omv-readonly": false,
        "x-omv-source": {
          "datamodel": "rpc.exec.isrunning",
          "omvVersion": "8.6.1"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecHandleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The method's response value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecRunning"
                },
                "examples": {
                  "running": {
                    "$ref": "#/components/examples/execIsRunning.running"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rpc/Exec/stop": {
      "post": {
        "operationId": "execStop",
        "tags": ["Exec"],
        "summary": "Stop a task",
        "description": "Used only by the task helper. Ends the task; the handle is gone afterwards. Returns null.",
        "x-omv-rpc": {
          "service": "Exec",
          "method": "stop"
        },
        "x-omv-role": "admin",
        "x-omv-readonly": false,
        "x-omv-source": {
          "datamodel": "rpc.exec.stop",
          "omvVersion": "8.6.1"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecHandleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The method returns null."
          }
        }
      }
    },
    "/rpc/SSH/get": {
      "post": {
        "operationId": "sshGet",
        "tags": ["SSH"],
        "summary": "SSH settings",
        "description": "The SSH service settings.",
        "x-omv-rpc": {
          "service": "SSH",
          "method": "get"
        },
        "x-omv-role": "admin",
        "x-omv-readonly": true,
        "responses": {
          "200": {
            "description": "The method's response value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SshSettings"
                },
                "examples": {
                  "defaults": {
                    "$ref": "#/components/examples/sshGet.defaults"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rpc/SSH/set": {
      "post": {
        "operationId": "sshSet",
        "tags": ["SSH"],
        "summary": "Save SSH settings",
        "description": "Save the SSH settings. Nothing changes on the system until the pending changes are applied. Returns the stored settings.",
        "x-omv-rpc": {
          "service": "SSH",
          "method": "set"
        },
        "x-omv-role": "admin",
        "x-omv-readonly": false,
        "x-omv-dirty": true,
        "x-omv-source": {
          "datamodel": "rpc.ssh.set",
          "omvVersion": "8.6.1"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SshSetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The method's response value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SshSettings"
                },
                "examples": {
                  "saved": {
                    "$ref": "#/components/examples/sshSet.saved"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rpc/ShareMgmt/getList": {
      "post": {
        "operationId": "shareMgmtGetList",
        "tags": ["ShareMgmt"],
        "summary": "Shared folders",
        "description": "A page of shared folders, sorted and searched by the backend.",
        "x-omv-rpc": {
          "service": "ShareMgmt",
          "method": "getList"
        },
        "x-omv-role": "admin",
        "x-omv-readonly": true,
        "x-omv-source": {
          "datamodel": "rpc.common.getlist",
          "omvVersion": "8.6.1"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetListRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The method's response value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SharedFolderList"
                },
                "examples": {
                  "populated": {
                    "$ref": "#/components/examples/shareMgmtGetList.populated"
                  },
                  "searchNoMatch": {
                    "$ref": "#/components/examples/shareMgmtGetList.searchNoMatch"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rpc/UserMgmt/getUserByContext": {
      "post": {
        "operationId": "userMgmtGetUserByContext",
        "tags": ["UserMgmt"],
        "summary": "My account",
        "description": "The signed-in user's own account.",
        "x-omv-rpc": {
          "service": "UserMgmt",
          "method": "getUserByContext"
        },
        "x-omv-role": "user",
        "x-omv-readonly": true,
        "responses": {
          "200": {
            "description": "The method's response value.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserByContext"
                },
                "examples": {
                  "user": {
                    "$ref": "#/components/examples/userMgmtGetUserByContext.user"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfigAppliedModules": {
        "type": "array",
        "description": "The result of an apply task (its final output, parsed as JSON) - the modules deployed.",
        "items": {
          "type": "string"
        }
      },
      "Username": {
        "type": "string",
        "description": "An account name, in OMV's `username` format.",
        "x-omv-format": "username",
        "pattern": "^[a-zA-Z0-9_.][a-zA-Z0-9_.-]*\\$?$"
      },
      "SessionLoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "$ref": "#/components/schemas/Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "x-omv-secret": true,
            "x-omv-format": "no-multi-line",
            "pattern": "^[^\\r\\n]*$"
          }
        }
      },
      "Role": {
        "type": "string",
        "description": "The session's role. `admin` is an administrator; anything else is treated as a user.",
        "enum": ["admin", "user"]
      },
      "SessionPermissions": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "SessionAuthenticated": {
        "type": "object",
        "description": "A signed-in session. The server also sends `sessionid`; the transport ignores it and it is not described here (UI-6). The session lives in OMV's HttpOnly cookie.",
        "required": ["status", "username", "permissions"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["authenticated"]
          },
          "username": {
            "type": "string"
          },
          "permissions": {
            "$ref": "#/components/schemas/SessionPermissions"
          }
        }
      },
      "SessionChallengeRequired": {
        "type": "object",
        "description": "The password was right and a second factor is required. The interface shows its own screen for each `kind` it knows (A10). The server also sends `challenge.redirecturl`, a route of the stock interface; it is ignored and not described here (UI-3). No other call may be made before Session.verify: any call discards the pending challenge.",
        "required": ["status", "username", "challenge"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["challengeRequired"]
          },
          "username": {
            "type": "string"
          },
          "challenge": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "description": "The second-factor method, e.g. `totp`. An unknown kind sends the user to the classic interface."
              }
            }
          }
        }
      },
      "SessionLoginReply": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SessionAuthenticated"
          },
          {
            "$ref": "#/components/schemas/SessionChallengeRequired"
          }
        ],
        "discriminator": {
          "propertyName": "status",
          "mapping": {
            "authenticated": "#/components/schemas/SessionAuthenticated",
            "challengeRequired": "#/components/schemas/SessionChallengeRequired"
          }
        }
      },
      "RpcErrorDetail": {
        "type": "object",
        "description": "The `error` member of an rpc.php failure reply. The transport turns it into an RpcError with the HTTP status; its `trace` is discarded at once and never described here (UI-9). `code` is 0 for every error observed (A8), so the status and the message are the only signals.",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "integer",
            "nullable": true
          },
          "message": {
            "type": "string",
            "description": "The backend's message, already translated by the server. Shown as text."
          }
        }
      },
      "SessionVerifyRequest": {
        "type": "object",
        "description": "The answer to a `totp` challenge (openmediavault-2fa-totp, A10). OMV's core accepts any value here and hands it to the two-factor plugin; the contract accepts only the one shape the interface sends.",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string",
            "description": "The six-digit one-time code.",
            "pattern": "^[0-9]{6}$",
            "x-omv-secret": true
          }
        }
      },
      "SystemInformation": {
        "type": "object",
        "description": "System information. Every signed-in user gets `ts`, `time` and `hostname`; an administrator also gets the rest.",
        "required": ["ts", "time", "hostname"],
        "properties": {
          "ts": {
            "type": "integer",
            "description": "Unix time on the server, in seconds."
          },
          "time": {
            "type": "string",
            "description": "Display text, the server's local time in the server's locale."
          },
          "hostname": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "description": "Display text, e.g. \"8.6.1-1 (Synchrony)\"."
          },
          "cpuModelName": {
            "type": "string",
            "nullable": true
          },
          "cpuUtilization": {
            "type": "number",
            "description": "Percent, 0 to 100."
          },
          "cpuCores": {
            "type": "integer",
            "nullable": true
          },
          "cpuMhz": {
            "type": "number",
            "nullable": true
          },
          "memTotal": {
            "type": "string",
            "x-omv-int64": true,
            "description": "Bytes."
          },
          "memFree": {
            "type": "string",
            "x-omv-int64": true,
            "description": "Bytes."
          },
          "memUsed": {
            "type": "string",
            "x-omv-int64": true,
            "description": "Bytes."
          },
          "memAvailable": {
            "type": "string",
            "x-omv-int64": true,
            "description": "Bytes."
          },
          "memUtilization": {
            "type": "string",
            "description": "A fraction from 0 to 1, as a decimal string (A4)."
          },
          "kernel": {
            "type": "string",
            "description": "Display text."
          },
          "uptime": {
            "type": "number",
            "description": "Seconds."
          },
          "loadAverage": {
            "type": "object",
            "properties": {
              "1min": {
                "type": "number"
              },
              "5min": {
                "type": "number"
              },
              "15min": {
                "type": "number"
              }
            }
          },
          "configDirty": {
            "type": "boolean"
          },
          "dirtyModules": {
            "type": "object",
            "description": "Module name to the module's description (display text). An empty map arrives as `[]`; the transport turns it into `{}`.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "rebootRequired": {
            "type": "boolean"
          },
          "availablePkgUpdates": {
            "type": "integer"
          },
          "displayWelcomeMessage": {
            "type": "boolean"
          }
        }
      },
      "ConfigIsDirtyRequest": {
        "type": "object",
        "properties": {
          "modules": {
            "type": "array",
            "description": "Ask about these modules only. Empty or absent asks about every module.",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ConfigApplyChangesRequest": {
