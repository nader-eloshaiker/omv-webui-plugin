{
  "name": "@omv-webui/react-ui-components",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "GPL-3.0-or-later",
  "description": "The shared, app-agnostic components of the interface (style guide section 5), on Base UI, with Storybook stories in both themes.",
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --quiet"
  },
  "dependencies": {
    "@base-ui/react": "catalog:ui",
    "@omv-webui/css-ui-style": "workspace:*",
    "class-variance-authority": "catalog:ui",
    "clsx": "catalog:ui",
    "lucide-react": "catalog:ui",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tailwind-merge": "catalog:ui"
  },
  "devDependencies": {
    "@storybook/addon-docs": "catalog:storybook",
    "@storybook/addon-themes": "catalog:storybook",
    "@storybook/react-vite": "catalog:storybook",
    "@tailwindcss/vite": "catalog:style",
    "@testing-library/jest-dom": "catalog:testing",
    "@testing-library/react": "catalog:testing",
    "@testing-library/user-event": "catalog:testing",
    "@types/node": "catalog:build",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "jsdom": "catalog:testing",
    "storybook": "catalog:storybook",
    "vite": "catalog:build",
    "vitest": "catalog:testing"
  }
}
